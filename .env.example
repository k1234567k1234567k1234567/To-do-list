# Postgres (Neon / Vercel Postgres). If unset, tasks are stored in .data/ for local dev.
DATABASE_URL=
# Grok (xAI). If unset, a rule-based summarizer is used.
XAI_API_KEY=
RESEND_API_KEY=
FROM_EMAIL=Todo <onboarding@resend.dev>
# Protects /api/cron/reminders (Vercel sends it as a Bearer token automatically)
CRON_SECRET=
# Single-user login passcode. If unset, no login required (local dev only).
APP_PASSCODE=
